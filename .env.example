# This project intentionally has almost no environment variables.
# The frontend never needs a backend URL for camera work, because the
# camera pipeline is fully client-side.

# Optional CDN base for product imagery. If unset, the seed data ships
# with inline SVG placeholders and requires no external network.
NEXT_PUBLIC_PRODUCT_ASSET_BASE=

# Set to "1" to force the client into the "no local ML" fallback path.
# Useful during QA to confirm the fallback UX.
NEXT_PUBLIC_FORCE_FALLBACK=
